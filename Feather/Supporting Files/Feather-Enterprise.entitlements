<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Enhanced File System Access for Enterprise/AdHoc Signing -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    
    <!-- Network Access -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- Keychain Access -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)BabaApp.Babaman.baba</string>
    </array>
    
    <!-- Document and Downloads Directory Access -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>Documents/</string>
        <string>Downloads/</string>
        <string>Library/</string>
        <string>tmp/</string>
        <string>Caches/</string>
    </array>
    
    <!-- Temporary Files Access -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/private/tmp/</string>
        <string>/var/tmp/</string>
        <string>/private/var/tmp/</string>
        <string>/System/Library/Caches/</string>
    </array>
    
    <!-- Get Task Allow (for debugging) -->
    <key>get-task-allow</key>
    <true/>
    
    <!-- App Groups (if your mobileprovision supports it) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.BabaApp.shared</string>
    </array>
    
    <!-- Background Modes (if your mobileprovision supports it) -->
    <key>com.apple.developer.background-modes</key>
    <array>
        <string>background-processing</string>
        <string>background-fetch</string>
        <string>background-app-refresh</string>
    </array>
    
    <!-- Associated Domains (if your mobileprovision supports it) -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:*.babaapps.com</string>
    </array>
    
    <!-- Custom URL Schemes -->
    <key>com.apple.developer.networking.custom-protocol</key>
    <array>
        <string>feather</string>
        <string>itms-services</string>
    </array>
</dict>
</plist>