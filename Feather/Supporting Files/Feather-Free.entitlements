<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Basic File System Access (Free Account Compatible) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    
    <!-- Basic Network Access -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Background Processing (Limited for Free Accounts) -->
    <key>com.apple.developer.background-modes</key>
    <array>
        <string>background-processing</string>
    </array>
    
    <!-- Keychain Access -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)BabaApp.Babaman.baba</string>
    </array>
    
    <!-- Get Task Allow (for debugging) -->
    <key>get-task-allow</key>
    <true/>
    
    <!-- 
    REMOVED FOR FREE ACCOUNT COMPATIBILITY:
    - com.apple.developer.associated-domains (Requires Paid Account)
    - com.apple.security.application-groups (Requires Paid Account)
    - com.apple.developer.networking.custom-protocol (Requires Paid Account)
    - background-fetch and background-downloads (Limited on Free Account)
    -->
</dict>
</plist>